<{include "head.cms"}>
<div class="container"> 
    <div class="row">
        <div class="col-md-4 mb-2">
        <{include "my_nav.cms"}>
        </div>
        <div class="col-md-8">
            <div class="panel-heading">
                 <h5 class="media-heading">
                     <{$webplace}>
                 </h5>
            </div>
            <div class="border">
                <div class="card-body">
                    <{if $plugin_file}>
                        <{php=>require_once return=>$plugin_file;}>
                    <{else}>
                        此插件无管理端<br/>This plugin has no management end<br/>
                        Example <code>plugin=><{$pid}></code> / <code>Inc::Plugin("<{$pid}>")</code>
                    <{/if}>
                </div>
            </div>
        </div>
    </div>
</div>
<{include "foot.cms"}>